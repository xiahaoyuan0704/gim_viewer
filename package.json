{
  "name": "gim-reader",
  "version": "0.0.1",
  "description": "GIM 浏览器",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop:dev": "npm run electron:dev",
    "electron:dev": "npm run build && npx --yes electron .",
    "desktop:pack": "npm run build && npx --yes electron-builder --dir",
    "desktop:dist": "npm run build && npx --yes electron-builder"
  },
  "author": "bamboosjtu",
  "license": "MIT",
  "dependencies": {
    "@thatopen/components": "^3.4.6",
    "@thatopen/fragments": "^3.4.0",
    "camera-controls": "^3.1.2",
    "libarchive.js": "^2.0.2",
    "three": "^0.184.0",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "7zip-min": "^3.0.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "cn.gim.viewer",
    "productName": "GIM Viewer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      "public/web-ifc.wasm",
      "public/web-ifc-mt.wasm",
      "public/libarchive.wasm",
      "public/worker-bundle.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
