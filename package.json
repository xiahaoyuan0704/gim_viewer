{
  "name": "gim-reader",
  "version": "0.0.1",
  "description": "GIM 桌面阅读器",
  "type": "module",
  "scripts": {
    "dev": "node scripts/desktop-dev.cjs",
    "start": "node scripts/desktop-dev.cjs",
    "build:renderer": "tsc && vite build",
    "build": "npm run build:renderer && electron-builder",
    "pack": "npm run build:renderer && electron-builder --dir"
  },
  "author": "bamboosjtu",
  "license": "MIT",
  "dependencies": {
    "@thatopen/components": "^3.4.6",
    "@thatopen/fragments": "^3.4.0",
    "camera-controls": "^3.1.2",
    "libarchive.js": "^2.0.2",
    "three": "^0.184.0",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "7zip-min": "^3.0.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.gim.viewer",
    "productName": "GIM 阅读器",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
